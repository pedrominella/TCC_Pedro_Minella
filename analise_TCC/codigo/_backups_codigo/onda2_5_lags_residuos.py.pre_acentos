# -*- coding: utf-8 -*-
"""
ONDA 2, ITEM 2.5 -- ESCADA DE DEFASAGENS E AUTOCORRELACAO RESIDUAL

Duas pecas que o PLANO_REORGANIZACAO listava como pendentes (secao 5, itens 1 e 2) e
que alimentam a Tabela 4, os paragrafos 214-216, o paragrafo 165 e a Tabela G.2.

(1) ESCADA DE DEFASAGENS 3 / 6 / 12
    A especificacao principal usa 3 defasagens. A pergunta e se o repasse estimado
    depende disso. Roda-se a LP-OLS com 3, 6 e 12 defasagens de tudo que entra
    defasado (a propria variavel, o choque e os quatro controles).

    Cada escada e reportada em DUAS amostras:
      "propria"  -- a amostra maxima de cada numero de defasagens (praxe)
      "comum"    -- a amostra do modelo de 12 defasagens, igual para os tres
    Sem a segunda, diferenca de defasagem e diferenca de amostra ficam confundidas,
    que e justamente o que a tabela quer separar.

(2) BREUSCH-GODFREY EM h=0
    Em h=0 a dependente e a variacao de um mes so e o teste de autocorrelacao
    residual e DIRETAMENTE INTERPRETAVEL. Em h>0 a dependente acumulada gera
    sobreposicao mecanica entre observacoes vizinhas, e portanto autocorrelacao
    ESPERADA, que e exatamente o que o HAC existe para tratar -- ali o teste nao
    diagnostica ma especificacao, so confirma a sobreposicao. Por isso a tabela do
    apendice deve ser de h=0.

    Reporta-se o BG classico (LM homocedastico, comparavel ao que esta no texto) e
    uma versao ROBUSTA a heterocedasticidade: a regressao auxiliar do residuo sobre
    o desenho mais p residuos defasados, com Wald HC3 sobre os residuos defasados.
    Isso importa porque as series tem ARCH forte -- o diagnostico da Onda 1 achou
    curtose de 8 a 15 --, e sob ARCH o LM classico SOBRE-REJEITA. Se os dois
    discordarem, o robusto e o que vale.

    Testa-se com 1, 6 e 12 defasagens de residuo: 1 e o vizinho imediato, 12 e
    sazonalidade anual remanescente.

Os numeros que estao hoje no paragrafo 165 (p = 0,006 para a refinaria e p = 0,037
para o diesel, com 3 defasagens) vem da especificacao ANTIGA -- com controles
contemporaneos, serie de juros errada e sem dummies de pandemia. Sao orfaos e
precisam ser substituidos pelos daqui.

ESPECIFICACAO: a de referencia da pasta -- resposta acumulada em log-nivel, meta
Selic SGS 432, controles so defasados, dummies de pandemia por janela do horizonte,
HAC com T/(T-K).

Uso: python onda2_5_lags_residuos.py rodar | figuras
"""
import sys, warnings, numpy as np, pandas as pd
from pathlib import Path
import statsmodels.api as sm
from scipy import stats
warnings.filterwarnings("ignore")

AQUI = Path(__file__).resolve().parent
PASTA = AQUI.parent
SAIDA = PASTA / "resultados"; FIGS = PASTA / "figuras"
SAIDA.mkdir(parents=True, exist_ok=True); FIGS.mkdir(parents=True, exist_ok=True)

import lp_base_nova as L

ESCADA = [3, 6, 12]
LAGS_PRINCIPAL = 3
BG_LAGS = [1, 6, 12]
P_GRADE = list(range(1, 13))   # grade de defasagens para a selecao
PRINCIPAIS = ["gasolina_consumidor", "diesel", "ipca_transportes", "ipca_geral"]


def _regressores(p):
    """Defasagens 1..p da propria variavel, do choque e dos quatro controles."""
    r = []
    for lag in range(1, p + 1):
        r += [f"y_lag{lag}", f"choque_petroleo_lag{lag}"] + \
             [f"{c}_lag{lag}" for c in L.CONTROLES]
    return r


def bg_robusto(X, resid, p):
    """Breusch-Godfrey com Wald robusto a heterocedasticidade.

    Regressao auxiliar: u_t sobre [X_t, u_{t-1}, ..., u_{t-p}], com os residuos
    defasados preenchidos com zero no inicio (convencao usual), e Wald sobre os
    coeficientes dos residuos defasados. Devolve estatistica, graus de liberdade
    e p-valor (qui-quadrado com p graus de liberdade).

    HC1, nao HC3: em h=0 as indicadoras de pandemia sao impulsos de um mes, entao
    aquelas 10 observacoes tem alavancagem h_ii = 1 e residuo exatamente zero -- o
    peso 1/(1-h_ii)^2 do HC3 fica indefinido e a covariancia sai NaN. HC1 usa a
    mesma correcao T/(T-K) adotada no resto do projeto e nao tem esse problema.
    """
    T = len(resid)
    Z = np.column_stack([np.concatenate([np.zeros(l), resid[:T - l]]) for l in range(1, p + 1)])
    Xa = np.column_stack([X, Z])
    r = sm.OLS(resid, Xa).fit(cov_type="HC1")
    k = X.shape[1]
    R = np.zeros((p, Xa.shape[1]))
    for i in range(p):
        R[i, k + i] = 1.0
    V = r.cov_params()
    RV = R @ np.asarray(V) @ R.T
    est = float((R @ np.asarray(r.params)) @ np.linalg.pinv(RV) @ (R @ np.asarray(r.params)))
    return est, p, float(stats.chi2.sf(est, p))


def selecao():
    """Qual defasagem p usar? Criterios de informacao + LR sequencial + residuo branco.

    IMPORTANTE, e o texto precisa dizer: p (numero de defasagens dos controles) e h
    (horizonte da resposta) sao parametros DIFERENTES. p nao governa a velocidade do
    repasse -- essa esta na forma de beta(h) ao longo de h, e h=0 ja e o efeito
    contemporaneo. p existe para limpar a dinamica previsivel e deixar o residuo
    branco. Menos defasagens nao tornam a resposta mais imediata; so deixam
    dinamica nao modelada dentro do erro.

    A selecao e feita na regressao de h=0, que e a equacao dinamica de um passo, e
    numa AMOSTRA COMUM a todo p (a de p=12), sem a qual AIC e BIC nao sao
    comparaveis entre si.

    Tres criterios:
      AIC / BIC / HQ  -- BIC penaliza mais e tende a escolher menos defasagens
      LR sequencial   -- testa se o ultimo bloco de defasagens acrescenta algo,
                         em versao robusta (Wald HC1), porque as series tem ARCH
      Breusch-Godfrey -- p precisa ser grande o bastante para nao sobrar
                         autocorrelacao; e a restricao que realmente importa
    """
    b, dum, pand = L.carregar_pandemia("corrigida")
    pmax = max(P_GRADE)
    linhas = []
    for nome in L.VARIAVEIS:
        d = b.copy()
        for lag in range(1, pmax + 1):
            d[f"y_lag{lag}"] = d[f"dlog_{nome}"].shift(lag)
            d[f"choque_petroleo_lag{lag}"] = d["choque_petroleo"].shift(lag)
            for c in L.CONTROLES:
                d[f"{c}_lag{lag}"] = d[c].shift(lag)
        d["__y"] = L.y_acum(d, nome, 0)
        pand_h = pand(d, 0)
        regs_max = ["choque_petroleo"] + _regressores(pmax) + dum + pand_h
        comuns = set(d[["Data", "__y"] + regs_max].replace(
            [np.inf, -np.inf], np.nan).dropna()["Data"])
        anterior = None
        for p in P_GRADE:
            regs = ["choque_petroleo"] + _regressores(p) + dum + pand_h
            am = d[["Data", "__y"] + regs].replace([np.inf, -np.inf], np.nan).dropna()
            am = am[am["Data"].isin(comuns)]
            X = sm.add_constant(am[regs], has_constant="add")
            r = sm.OLS(am["__y"], X).fit()
            T, K = int(r.nobs), X.shape[1]
            rh = sm.OLS(am["__y"], X).fit(cov_type="HAC", cov_kwds=L.hac_kw(0))
            reg = {"variavel": nome, "p": p, "observacoes": T, "regressores": K,
                   "aic": float(r.aic), "bic": float(r.bic),
                   "hq": float(-2 * r.llf + 2 * K * np.log(np.log(T))),
                   "coeficiente_choque": float(rh.params["choque_petroleo"]),
                   "p_valor_choque": float(rh.pvalues["choque_petroleo"])}
            # LR sequencial robusto: o bloco de defasagem p acrescenta algo sobre p-1?
            if anterior is not None:
                bloco = [f"y_lag{p}", f"choque_petroleo_lag{p}"] + \
                        [f"{c}_lag{p}" for c in L.CONTROLES]
                rr = sm.OLS(am["__y"], X).fit(cov_type="HC1")
                idx = [list(X.columns).index(c) for c in bloco]
                R = np.zeros((len(idx), X.shape[1]))
                for i, j in enumerate(idx):
                    R[i, j] = 1.0
                pa = np.asarray(rr.params)
                RV = R @ np.asarray(rr.cov_params()) @ R.T
                est = float((R @ pa) @ np.linalg.pinv(RV) @ (R @ pa))
                reg["wald_bloco_p"] = est
                reg["wald_bloco_gl"] = len(idx)
                reg["wald_bloco_pvalor"] = float(stats.chi2.sf(est, len(idx)))
            # residuo branco?
            u = np.asarray(r.resid, float)
            for q in BG_LAGS:
                try:
                    reg[f"bg_robusto_p_q{q}"] = bg_robusto(np.asarray(X, float), u, q)[2]
                except Exception:
                    reg[f"bg_robusto_p_q{q}"] = np.nan
            linhas.append(reg)
            anterior = p
        print(f"  {nome}")

    t = pd.DataFrame(linhas)
    with pd.ExcelWriter(SAIDA / "onda2_5_selecao_lags.xlsx") as w:
        t.to_excel(w, sheet_name="selecao", index=False)

    print("\n=== p que MINIMIZA cada criterio de informacao (h=0, amostra comum) ===")
    esc = t.loc[t.groupby("variavel")[["aic"]].idxmin()["aic"], ["variavel", "p"]].set_index("variavel")
    for crit in ["aic", "bic", "hq"]:
        esc[crit] = t.loc[t.groupby("variavel")[[crit]].idxmin()[crit], ["variavel", "p"]].set_index("variavel")["p"]
    print(esc[["aic", "bic", "hq"]].to_string())
    print("\nmoda entre as seis variaveis:")
    for crit in ["aic", "bic", "hq"]:
        print(f"  {crit.upper()}: p = {int(esc[crit].mode().iloc[0])}"
              f"  (mediana {esc[crit].median():.1f})")

    print("\n=== menor p que deixa o residuo branco a 5% (BG robusto, q=1, 6 e 12) ===")
    for nome, g in t.groupby("variavel"):
        ok = g[(g.bg_robusto_p_q1 > 0.05) & (g.bg_robusto_p_q6 > 0.05) & (g.bg_robusto_p_q12 > 0.05)]
        print(f"  {nome:22s} " + (f"p = {int(ok.p.min())}" if len(ok) else "nenhum p de 1 a 12 limpa"))

    print("\n=== ultimo p cujo bloco de defasagens ainda e conjuntamente significativo (10%) ===")
    for nome, g in t.groupby("variavel"):
        s = g[g.wald_bloco_pvalor < 0.10]
        print(f"  {nome:22s} " + (f"p = {int(s.p.max())}" if len(s) else "nenhum bloco significativo"))

    print("\n=== o coeficiente do choque em h=0 depende de p? ===")
    print(t.pivot_table(index="variavel", columns="p",
                        values="coeficiente_choque").round(3).to_string())
    return t


def rodar():
    b, dum, pand = L.carregar_pandemia("corrigida")
    pmax = max(ESCADA)
    linhas, residuos = [], []

    for nome in L.VARIAVEIS:
        d = b.copy()
        for lag in range(1, pmax + 1):
            d[f"y_lag{lag}"] = d[f"dlog_{nome}"].shift(lag)
            d[f"choque_petroleo_lag{lag}"] = d["choque_petroleo"].shift(lag)
            for c in L.CONTROLES:
                d[f"{c}_lag{lag}"] = d[c].shift(lag)

        for h in range(0, L.H_MAX + 1):
            d["__y"] = L.y_acum(d, nome, h)
            pand_h = pand(d, h)
            # amostra comum = a do modelo mais longo, no mesmo horizonte
            regs_max = ["choque_petroleo"] + _regressores(pmax) + dum + pand_h
            datas_comuns = set(d[["Data", "__y"] + regs_max].replace(
                [np.inf, -np.inf], np.nan).dropna()["Data"])

            for p in ESCADA:
                regs = ["choque_petroleo"] + _regressores(p) + dum + pand_h
                am_propria = d[["Data", "__y"] + regs].replace(
                    [np.inf, -np.inf], np.nan).dropna()
                for rot_am, am in [("propria", am_propria),
                                   ("comum", am_propria[am_propria["Data"].isin(datas_comuns)])]:
                    X = sm.add_constant(am[regs], has_constant="add")
                    r = sm.OLS(am["__y"], X).fit(cov_type="HAC", cov_kwds=L.hac_kw(h))
                    cf, ep = r.params["choque_petroleo"], r.bse["choque_petroleo"]
                    linhas.append({
                        "variavel": nome, "lags": p, "amostra": rot_am, "h": h,
                        "coeficiente": cf, "erro_padrao": ep,
                        "estatistica_t": r.tvalues["choque_petroleo"],
                        "p_valor": r.pvalues["choque_petroleo"],
                        "limite_inferior_90": cf - L.Z_90 * ep,
                        "limite_superior_90": cf + L.Z_90 * ep,
                        "observacoes": int(r.nobs), "regressores": X.shape[1]})

                    # (2) Breusch-Godfrey, so em h=0 e so na amostra propria
                    if h == 0 and rot_am == "propria":
                        Xv = np.asarray(X, float)
                        u = np.asarray(r.resid, float)
                        r_ols = sm.OLS(am["__y"], X).fit()
                        for q in BG_LAGS:
                            try:
                                est_c, p_c = sm.stats.acorr_breusch_godfrey(r_ols, nlags=q)[:2]
                            except Exception:
                                est_c, p_c = np.nan, np.nan
                            try:
                                est_r, gl_r, p_r = bg_robusto(Xv, u, q)
                            except Exception:
                                est_r, gl_r, p_r = np.nan, q, np.nan
                            residuos.append({
                                "variavel": nome, "lags_modelo": p, "bg_lags": q,
                                "bg_classico": est_c, "bg_classico_p": p_c,
                                "bg_robusto": est_r, "bg_robusto_p": p_r,
                                "observacoes": int(r.nobs)})
        print(f"  {nome}")

    t = pd.DataFrame(linhas); tr = pd.DataFrame(residuos)
    with pd.ExcelWriter(SAIDA / "onda2_5_lags_residuos.xlsx") as w:
        t.to_excel(w, sheet_name="escada_completa", index=False)
        t[t.h.isin(L.HORIZONTES)].to_excel(w, sheet_name="tabela_artigo", index=False)
        tr.to_excel(w, sheet_name="breusch_godfrey_h0", index=False)

    print("\n=== (1) escada de defasagens, amostra COMUM, horizontes do artigo ===")
    v = t[(t.amostra == "comum") & (t.h.isin([0, 3, 6, 12]))]
    print(v.pivot_table(index=["variavel", "h"], columns="lags",
                        values="coeficiente").round(3).to_string())
    print("\np-valor correspondente:")
    print(v.pivot_table(index=["variavel", "h"], columns="lags",
                        values="p_valor").round(3).to_string())

    print("\n=== sensibilidade: quanto o coeficiente muda de 3 para 6 e 12 defasagens ===")
    for rot_am in ["comum", "propria"]:
        s = t[t.amostra == rot_am].pivot_table(index=["variavel", "h"], columns="lags",
                                               values="coeficiente")
        s = s.dropna()
        base = s[LAGS_PRINCIPAL].abs().clip(lower=0.05)
        print(f"  amostra {rot_am:8s}: mediana |dif| relativa  3->6 = "
              f"{((s[6] - s[3]).abs() / base).median():.2f}  "
              f"3->12 = {((s[12] - s[3]).abs() / base).median():.2f}")
    ver = t[t.amostra == "comum"].pivot_table(index=["variavel", "h"], columns="lags",
                                              values="p_valor").dropna()
    for q in [6, 12]:
        muda = int(((ver[LAGS_PRINCIPAL] < 0.10) != (ver[q] < 0.10)).sum())
        print(f"  vereditos a 10% que mudam de 3 para {q} defasagens: {muda} de {len(ver)}")

    print("\n=== (2) Breusch-Godfrey em h=0 (unico horizonte interpretavel) ===")
    v = tr[tr.lags_modelo == LAGS_PRINCIPAL]
    print(v.pivot_table(index="variavel", columns="bg_lags",
                        values=["bg_classico_p", "bg_robusto_p"]).round(3).to_string())
    for col, rot in [("bg_classico_p", "classico"), ("bg_robusto_p", "robusto ")]:
        print(f"  rejeicoes a 5% ({rot}): {int((v[col] < 0.05).sum())} de {len(v)}")
    print("\nModelos com 6 e 12 defasagens resolvem o que sobra em 3?")
    print(tr.pivot_table(index="lags_modelo", columns="bg_lags",
                         values="bg_robusto_p", aggfunc=lambda s: (s < 0.05).sum()).to_string())
    print("(valores = quantas das 6 variaveis rejeitam a 5% no teste robusto)")
    return t, tr


def figuras():
    import matplotlib; matplotlib.use("Agg")
    import matplotlib.pyplot as plt
    t = pd.read_excel(SAIDA / "onda2_5_lags_residuos.xlsx", sheet_name="escada_completa")
    cores = {3: "#0B5A56", 6: "#9E3D25", 12: "#5F6549"}
    fig, axes = plt.subplots(2, 2, figsize=(9.2, 6.2), sharex=True)
    for ax, nome in zip(axes.ravel(), PRINCIPAIS):
        for p in ESCADA:
            s = t[(t.variavel == nome) & (t.lags == p) & (t.amostra == "comum")].sort_values("h")
            ax.plot(s.h, s.coeficiente, color=cores[p], lw=1.8, label=f"{p} defasagens")
            if p == LAGS_PRINCIPAL:
                ax.fill_between(s.h, s.limite_inferior_90, s.limite_superior_90,
                                color=cores[p], alpha=0.15)
        ax.axhline(0, color="0.4", lw=0.8)
        ax.set_title(nome, fontsize=9)
        ax.set_xlabel("meses")
    axes[0, 0].set_ylabel("%"); axes[1, 0].set_ylabel("%")
    axes[0, 0].legend(fontsize=7)
    fig.suptitle("Resposta acumulada ao choque do petroleo: 3, 6 e 12 defasagens\n"
                 "amostra comum; faixa = IC de 90% da especificacao principal", fontsize=10)
    fig.tight_layout()
    fig.savefig(FIGS / "escada_defasagens.png", dpi=150); plt.close(fig)
    print("  figura escada_defasagens")


if __name__ == "__main__":
    {"rodar": rodar, "figuras": figuras, "selecao": selecao}[
        sys.argv[1] if len(sys.argv) > 1 else "rodar"]()
